run = "npm --prefix src/frontend run build && python src/main.py"
entrypoint = "src/main.py"

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 8000
externalPort = 80

[deployment]
build = ["sh", "-c", "pip install -r requirements.txt && npm --prefix src/frontend ci && npm --prefix src/frontend run build"]
run = ["python", "src/main.py"]
